{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mercer/stew/schema/metadata.schema.json",
  "title": "Stew metadata (meta.yaml)",
  "description": "Identity card for one merged stew. The only editable file in a stew directory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "slug", "title", "status", "state_history", "content", "lineage", "benchmarks", "safety", "legal", "community"],
  "properties": {
    "schema": { "const": "stew.metadata@1.0" },
    "id": { "type": "string", "pattern": "^STW-\\d{4}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string" },
    "status": { "enum": ["seed", "simmering", "mature", "retired", "quarantined", "sealed"] },
    "state_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "from", "to", "by", "ref"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "by": { "type": "string" },
          "ref": { "type": "string" }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "media_type", "charset", "bytes", "sha256", "human_readable", "visual_class", "token_estimate"],
      "properties": {
        "file": { "type": "string", "pattern": "^stew\\.gen-\\d{3}\\.txt$" },
        "media_type": { "type": "string" },
        "charset": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "human_readable": { "type": "boolean" },
        "visual_class": { "enum": ["readable", "compressed-text", "homoglyph-gibberish", "binary"] },
        "token_estimate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tokenizer", "tokens"],
          "properties": {
            "tokenizer": { "type": "string" },
            "tokens": { "type": "integer", "minimum": 0 },
            "note": { "type": "string" }
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "parents", "root_seed", "compression_ops_total"],
      "properties": {
        "generation": { "type": "integer", "minimum": 0 },
        "parents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "gen"],
            "properties": {
              "id": { "type": "string", "pattern": "^STW-\\d{4}$" },
              "gen": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "root_seed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_type", "provenance_note"],
          "properties": {
            "source_type": { "type": "string" },
            "corpus_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "provenance_note": { "type": "string" }
          }
        },
        "compression_ops_total": { "type": "integer", "minimum": 0 }
      }
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["suite", "model", "task", "baseline", "score", "delta", "runs", "harness"],
        "properties": {
          "suite": { "type": "string" },
          "model": { "type": "string" },
          "task": { "type": "string" },
          "baseline": { "type": "number" },
          "score": { "type": "number" },
          "delta": { "type": "number" },
          "runs": { "type": "integer", "minimum": 1 },
          "harness": { "type": "string" }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screen", "screen_ref", "redteam_probes", "disclosures"],
      "properties": {
        "screen": { "enum": ["pending", "passed", "flagged", "quarantined", "sealed"] },
        "screen_ref": { "type": ["string", "null"] },
        "redteam_probes": { "type": "integer", "minimum": 0 },
        "disclosures": { "type": "array", "items": { "type": "string" } }
      }
    },
    "legal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_license", "privacy_screened"],
      "properties": {
        "source_license": { "type": "string" },
        "privacy_screened": { "type": "boolean" }
      }
    },
    "community": {
      "type": "object",
      "additionalProperties": false,
      "required": ["curator", "tasting_count", "forks", "tags"],
      "properties": {
        "curator": { "type": "string" },
        "tasting_count": { "type": "integer", "minimum": 0 },
        "forks": { "type": "array", "items": { "type": "string", "pattern": "^STW-\\d{4}$" } },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}